global:
  LogLevel: "{{ .LogLevel }}"
  LogFormat: "{{ .LogFormat }}"
db:
  Path: "{{ .DBPath }}"
eth2:
  BeaconNodeAddr: "{{ .BeaconNodeAddr }}"
eth1:
  ETH1Addr: "{{ .ETH1Addr }}"
p2p:
  Discovery: "{{ .Discovery }}"
  Bootnodes: "{{ .ENR }}"

ssv:
  Network: "{{ .Network }}"
  CustomNetwork:
    Name: "{{ .NetworkName }}"
    DomainType: "{{ .DomainType }}"
    NextDomainType: "{{ .NextDomainType }}"
    RegistrySyncOffset: "{{ .RegistrySyncOffset }}"
    RegistryContractAddr: "{{ .RegistryContractAddr }}"
    DiscoveryProtocolID: "{{ .DiscoveryProtocolID }}"
    Forks:
      GasLimit36: 0
      Boole: {{ .BooleEpoch }}
exporter:
  Enabled: {{ .ExporterEnabled }}
  Mode: "{{ .ExporterMode }}"
OperatorPrivateKey: "{{ .OperatorPrivateKey }}"
SSVAPIPort: {{ .SSVAPIPort }}
EnableTraces: {{ .EnableTraces }}
MetricsAPIPort: {{ .MetricsAPIPort }}
{{- if .BuildersYAML }}
# Gloas direct-builder overlay (params key ssv_builders; JSON is valid YAML flow style).
Builders: {{ .BuildersYAML }}
{{- end }}
