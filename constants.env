# Single source of truth for the image pins and chain constants shared across ssv-mini.
#
# Three kinds of consumers read this file, so keep to the subset all of them parse:
#   - Starlark: utils/constants.star parses it (KEY=value or KEY="value"; blank lines and # comments skipped).
#   - make: the Makefile includes it. make keeps quotes literally, so it only uses unquoted values.
#   - bash: scripts/generate-static-keys.sh, scripts/ssv-mini and tests/faulty-el/run-test.sh source it.
# One assignment per line: no spaces around '=', no inline comments, no $-expansion; quote values with spaces.

# ── Service images ──
# The defaults behind a params file's images: block (keys ssv, anchor, monitor, redis, postgres, deployer);
# a params file overrides an entry only when its network needs a different build. node/ssv and monitor are
# local builds (make prepare-ssv / prepare-monitor tag them); the package builds the deployer itself.
SSV_IMAGE=node/ssv
ANCHOR_IMAGE=sigp/anchor:v1.3.1
MONITOR_IMAGE=monitor
REDIS_IMAGE=redis:7.4.2
POSTGRES_IMAGE=postgres:15
DEPLOYER_IMAGE=localssv/ssv-network

# ── Default EL/CL images ──
# main.star fills a participant's el_image / cl_image from these, matched on its el_type / cl_type, when the
# params file leaves it unset. params-gloas.yaml pins its own glamsterdam-devnet builds instead.
GETH_IMAGE=ethereum/client-go:v1.17.6
LIGHTHOUSE_IMAGE=sigp/lighthouse:v8.2.2

# ── Key-generation tools ──
# The anchor build scripts/generate-static-keys.sh runs keygen + keysplit with: kept at the version the
# committed static keys were generated with, separate from ANCHOR_IMAGE (the node).
KEYGEN_ANCHOR_IMAGE=sigp/anchor:v1.2.0
# Derives the validator keystores, in both the static-key script and the dynamic-keys path.
ETH2_VAL_TOOLS_IMAGE=protolambda/eth2-val-tools@sha256:098a46aa48e47da6450e40ac6ca32f41bc961adaf3cb8968e61de701fa7c72f5

# ── Chain constants ──
# Genesis validator mnemonic (also ethereum-package's default). main.star passes it to ethereum-package, and
# the static validator keys are derived from it, so regenerate them (make generate-keys) after changing it.
MNEMONIC="giant issue aisle success illegal bike spike question tent bar rely arctic volcano long crawl hungry vocal artwork sniff fantasy very lucky have athlete"
# Owner of the registered validators; the static keyshares are split for this owner.
OWNER_ADDRESS=0xe25583099ba105d9ec0a67f5ae86d90e50036425
# SSV contract addresses. They follow from the deployer account's nonce, so every fresh deploy lands on the
# same ones; contract/deployer.star checks the deployed proxy and token against them.
SSV_TOKEN_CONTRACT=0x6db20C530b3F96CD5ef64Da2b1b931Cb8f264009
SSV_OPERATORS_CONTRACT=0x6f00cAa972723C5e1D1012cdAc385753c2AA3a93
SSV_CLUSTERS_CONTRACT=0xDeC3326BE4BaDb9A1fA7Be473Ef8370dA775889a
SSV_NETWORK_CONTRACT=0x015B8C864D1B6e9BACd0DD666D77590cFd4188Cb
SSV_NETWORK_PROXY_CONTRACT=0xBFfF570853d97636b78ebf262af953308924D3D8
